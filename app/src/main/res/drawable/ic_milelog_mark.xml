        android:fillColor="#E6EDEC"
        android:pathData="M16,0 C16,0 0,18 0,30 a16,16 0 0 0 32,0 C32,18 16,0 16,0 Z" />

    <path
        android:fillColor="#101618"
        android:pathData="M16,6 C16,6 5,19 5,29 a11,11 0 0 0 22,0 C27,19 16,6 16,6 Z" />

    <path
        android:fillColor="#F0A83C"
