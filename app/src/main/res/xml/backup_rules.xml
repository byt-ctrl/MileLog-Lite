<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
      MileLog Lite promises that fuel logs never leave the device, so the Room
      database is kept out of cloud backup. Excludes narrow the default
      ("back up almost everything"); they do not disable other domains.
      Device-to-device transfer is governed separately by data_extraction_rules.xml.
    -->
    <exclude domain="database" path="." />
    <exclude domain="device_database" path="." />
</full-backup-content>